# Server port (default: 3000)
PORT=3000

# Set to "production" to enable safe error messages and CORS restriction
NODE_ENV=development

# Optional: custom path for SQLite database (default: server/data/pos.db)
# DB_PATH=/var/lib/pos/data/pos.db

# Optional: allowed CORS origins (comma-separated). If unset, all origins allowed.
# Production: set to your app's origin(s), e.g. https://your-app.com or http://localhost:PORT for Flutter web
# CORS_ORIGIN=https://your-app.com,https://www.your-app.com
